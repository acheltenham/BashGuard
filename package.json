{
  "name": "bashguard",
  "version": "0.0.2",
  "private": true,
  "description": "Local-first observability and safeguards for Pi coding sessions.",
  "type": "module",
  "bin": {
    "bashguard": "./bin/bashguard"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "observability",
    "security"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/bashguard/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "sessions": "node --experimental-strip-types src/cli.ts sessions"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  }
}
